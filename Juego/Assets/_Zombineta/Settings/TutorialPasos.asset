--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2bf4e4513b9c8904c86ae84a6fcfbfb6, type: 3}
  m_Name: TutorialPasos
  m_EditorClassIdentifier: Zombineta.Juego::Zombineta.Tutorial.TutorialPasos
  pasos:
  - texto: "Manten\xE9 {Turbo} para acelerar."
    condicion: 0
    cantidad: 1.5
    resaltar: 0
    hordaSuelta: 0
  - texto: "{LaneUp} / {LaneDown} cambian de carril. Prob\xE1 hacia los dos lados."
    condicion: 2
    cantidad: 0
    resaltar: 0
    hordaSuelta: 0
  - texto: "Sin nafta te baj\xE1s a pelear. Agarr\xE1 el bid\xF3n."
    condicion: 4
    cantidad: 1
    resaltar: 1
    hordaSuelta: 0
  - texto: "Pas\xE1 por la rampa. En el aire, {Turbo} / {Reverse} inclinan la moto."
    condicion: 3
    cantidad: 1
    resaltar: 0
    hordaSuelta: 0
  - texto: "La bater\xEDa alimenta el faro. Agarrala."
    condicion: 5
    cantidad: 1
    resaltar: 2
    hordaSuelta: 0
  - texto: "{Headlight} prende el faro: en los apagones es tu \xFAnica luz."
    condicion: 7
    cantidad: 1.5
    resaltar: 2
    hordaSuelta: 0
  - texto: "{Fire} dispara hacia atr\xE1s. Pegale a la horda."
    condicion: 8
    cantidad: 1
    resaltar: 3
    hordaSuelta: 0
  - texto: "{Granada} tira una granada hacia atr\xE1s."
    condicion: 10
    cantidad: 1
    resaltar: 0
    hordaSuelta: 0
  - texto: "\xA1Escap\xE1 de la horda! Lleg\xE1 al refugio."
    condicion: 9
    cantidad: 0
    resaltar: 4
    hordaSuelta: 1
